{
    "name": "berrybot",
    "description": "BerryBot is an Open Source discord bot, created to replace the corrupt discord bots that have monopolized discord.",
    "version": "0.0.1",
    "main": "build/index.js",
    "scripts": {
        "build": "tsc",
        "start": "yarn build && node -r dotenv/config build/index.js",
        "dev": "yarn build && node build/bot.js",
        "lint": "eslint ./src/**/*.ts --fix",
        "clean": "if exist build rmdir /s /q build && if exist tsconfig.tsbuildinfo del /f tsconfig.tsbuildinfo",
        "deleteModules": "if exist node_modules rmdir /s /q node_modules",
        "deleteLock": "if exist yarn.lock del /f yarn.lock",
        "installModules": "yarn install",
        "reinstall": "yarn cleanCache && yarn deleteModules && yarn deleteLock && yarn installModules",
        "cleanCache": "yarn cache clean"
    },
    "keywords": [
        "discord",
        "typescript"
    ],
    "husky": {
        "hooks": {
            "pre-commit": "precise-commits && yarn lint"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gwenphalan/berrybot.git"
    },
    "author": "Gwen Phalan",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/gwenphalan/berrybot/issues"
    },
    "homepage": "https://github.com/gwenphalan/berrybot#readme",
    "dependencies": {
        "@types/pino": "^7.0.5",
        "ascii-table": "^0.0.9",
        "canvas": "^3.1.0",
        "chalk": "^5.4.1",
        "discord.js": "^14.19.2",
        "dotenv": "^16.4.5",
        "glob": "^11.0.2",
        "mongoose": "^8.2.0",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/node": "^22.15.3",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "@typescript-eslint/parser": "^8.31.1",
        "eslint": "^9.25.1",
        "eslint-config-prettier": "^10.1.2",
        "eslint-config-xo": "^0.47.0",
        "eslint-config-xo-typescript": "^8.0.0",
        "eslint-plugin-prettier": "^5.1.3",
        "husky": "^9.0.11",
        "prettier": "^3.2.5",
        "typescript": "^5.8.3",
        "yarn": "^1.22.22"
    }
}
