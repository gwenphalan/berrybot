{
	"name": "berrybot",
	"description": "BerryBot is an Open Source discord bot, created to replace the corrupt discord bots that have monopolized discord.",
	"version": "0.0.1",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc && yarn copy-locales",
		"start": "yarn build && cross-env NODE_ENV=production node -r dotenv/config dist/index.js",
		"start:dev": "yarn build && cross-env NODE_ENV=development node -r dotenv/config dist/index.js --dev",
		"lint": "eslint ./src/**/*.ts --fix",
		"format": "prettier --write \"src/**/*.{ts,js,json}\"",
		"format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
		"lint:fix": "yarn lint && yarn format",
		"prepare": "husky",
		"clean": "rimraf dist tsconfig.tsbuildinfo",
		"deleteModules": "rimraf node_modules",
		"deleteLock": "rimraf yarn.lock",
		"installModules": "yarn install",
		"reinstall": "yarn cleanCache && yarn deleteModules && yarn deleteLock && yarn installModules",
		"cleanCache": "yarn cache clean",
		"emojis": "node scripts/filter-emojis.js",
		"setup": "node setup.js",
		"name-clash": "ts-node scripts/fix_name_clash.ts",
		"copy-locales": "ts-node scripts/copy-locales.ts"
	},
	"keywords": [
		"discord",
		"typescript"
	],
	"husky": {
		"hooks": {
			"pre-commit": "precise-commits && yarn lint"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gwenphalan/berrybot.git"
	},
	"author": "Gwen Phalan",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/gwenphalan/berrybot/issues"
	},
	"homepage": "https://github.com/gwenphalan/berrybot#readme",
	"dependencies": {
		"ascii-table": "^0.0.9",
		"bufferutil": "^4.0.9",
		"canvas": "^3.1.0",
		"discord.js": "^14.19.3",
		"dotenv": "^16.4.5",
		"glob": "^11.0.2",
		"inquirer": "^12.6.0",
		"lz-string": "^1.5.0",
		"module-alias": "^2.2.3",
		"mongoose": "^8.14.1",
		"pino": "^9.6.0",
		"pino-pretty": "^13.0.0",
		"winston": "^3.17.0",
		"yargs": "^17.7.2",
		"zlib-sync": "^0.1.10",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.26.0",
		"@types/chai": "^4.3.11",
		"@types/glob": "^8.1.0",
		"@types/node": "^22.15.12",
		"@types/pako": "^2.0.3",
		"@types/sinon-chai": "^3.2.9",
		"@types/yargs": "^17.0.33",
		"@typescript-eslint/eslint-plugin": "^8.32.0",
		"@typescript-eslint/parser": "^8.32.0",
		"cross-env": "^7.0.3",
		"eslint": "^9.26.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"prettier": "^3.5.3",
		"rimraf": "^6.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.32.0",
		"yarn": "^1.22.22"
	},
	"lint-staged": {
		"*.{ts,js}": [
			"npx eslint --fix",
			"npx prettier --write"
		],
		"*.{json,md}": [
			"npx prettier --write"
		]
	}
}
